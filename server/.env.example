# Required ------------------------------------------------------------------
# Postgres connection string. The Neon URL works unchanged — the schema is
# compatible and Flyway baselines an existing database on first boot.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# HMAC key for JWTs. MUST be the same value the previous Vercel functions used,
# otherwise every token already stored by the web app and the Android APK stops
# validating and users are logged out.
JWT_SECRET=change-me

# Optional -------------------------------------------------------------------
# Listen address/port. `PORT` is what Fly.io, Cloud Run, Railway and Heroku set.
PORT=8080
HOST=0.0.0.0

# Google Sign-In client ID. Defaults to the value compiled into the app.
GOOGLE_CLIENT_ID=

# Public base URL of the web app. Used to build password-reset links.
WEB_APP_URL=https://med-connect3-0.vercel.app

# Web Push (VAPID). Without both keys, push sending is disabled and
# POST /api/me {"action":"push_debug"} reports vapid_public_set=false.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@medconnect.app

# Daily.co API key, for OSCE video rooms. Without it, create_room returns
# 500 {"error":"Video not configured"}.
DAILY_API_KEY=

# Database pool size. Neon is serverless Postgres — keep this modest.
DATABASE_POOL_SIZE=10

# Set to false only if migrations are applied out of band.
RUN_MIGRATIONS=true